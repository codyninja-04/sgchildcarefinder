# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only used by the ECDA importer script, never by the web app
SUPABASE_SERVICE_ROLE_KEY=

# Claude
ANTHROPIC_API_KEY=
# Optional, defaults to claude-sonnet-5-5
CLAUDE_MODEL=

# Mapbox (the list view works without it)
NEXT_PUBLIC_MAPBOX_TOKEN=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: raises data.gov.sg's rate limit for the importer
DATA_GOV_SG_API_KEY=

# Set to true once billing is live to apply the free plan limits
ENFORCE_PRO=false
